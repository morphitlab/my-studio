---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fmt } from '../../lib/u';
const items = (await getCollection('timelines', e => !e.data.draft)).sort((a, b) => +b.data.start - +a.data.start);
const now = new Date();
// Rules: completed and on-hold come from the status you set. Otherwise the state comes from dates. Time elapsed is NOT progress.
const rows = items.map(t => {
  const d = t.data;
  const end = d.currentTarget ?? d.target;
  const extended = !!d.currentTarget && +d.currentTarget !== +d.target;
  let state = 'In progress';
  if (d.status === 'completed') state = d.completed ? 'Completed ' + fmt(d.completed) : 'Completed';
  else if (d.status === 'on-hold') state = 'On hold';
  else if (+now < +d.start) state = 'Not started';
  else if (+now > +end) state = 'Overdue';
  else if (+end - +now < 14 * 864e5) state = 'Approaching target';
  const span = Math.max(+end, +d.target) - +d.start || 1;
  const pct = (x: Date) => Math.min(100, Math.max(0, ((+x - +d.start) / span) * 100));
  return {
    id: t.id, title: d.title, description: d.description, state, extended,
    start: fmt(d.start), end: fmt(end), original: fmt(d.target),
    progress: d.progress, elapsed: Math.round(pct(now)),
    pTarget: pct(d.target), pEnd: pct(end), pNow: pct(now),
    done: ((d.progress ?? 0) * pct(end)) / 100,
    milestones: d.milestones.map(m => ({ title: m.title, date: fmt(m.date), pos: pct(m.date) })),
  };
});
---
<Base title="Timelines"><h1>The wall</h1>
{rows.length === 0 ? <p class="empty">No timelines yet. Create one in the CMS.</p> : rows.map(r => (
<article id={r.id} class="sheet tl">
<h2>{r.title}</h2>
<p class="meta"><b>{r.state}</b> · {r.start} to {r.end}{r.extended ? ' (originally ' + r.original + ')' : ''}</p>
<p>{r.description}</p>
<div class="bar" role="img" aria-label={'Status: ' + r.state + '. Progress ' + (r.progress ?? 'not set') + '%. Time elapsed ' + r.elapsed + '%.'}>
<i class="done" style={'width:' + r.done + '%'}></i>
<i class="ext" style={'left:' + r.pTarget + '%;width:' + (r.pEnd - r.pTarget) + '%'}></i>
<u class="now" style={'left:' + r.pNow + '%'}></u>
{r.milestones.map(m => <s class="ms" style={'left:' + m.pos + '%'} title={m.title + ', ' + m.date}></s>)}
</div>
<p class="meta">Actual progress: {r.progress != null ? r.progress + '%' : 'not set'} · Time elapsed: {r.elapsed}%</p>
<ul>{r.milestones.map(m => <li>{m.date}: {m.title}</li>)}</ul>
</article>))}
<style>.tl{margin-bottom:2rem}.bar{position:relative;height:1.1rem;background:#d6ccb6;margin:1.5rem 0 .5rem}.bar i{position:absolute;top:0;bottom:0}.done{background:var(--olive);left:0}.ext{background:repeating-linear-gradient(45deg,var(--amber) 0 6px,#f0c870 6px 12px)}
.now{position:absolute;top:-.5rem;bottom:-.5rem;width:3px;background:var(--red);text-decoration:none}.ms{position:absolute;top:-.3rem;width:.7rem;height:.7rem;background:var(--ink);transform:rotate(45deg)}</style></Base>
