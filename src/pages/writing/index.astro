---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { u, fmt } from '../../lib/u';
const posts = (await getCollection('writing', e => !e.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const cols = ['#6b7a45','#a6362b','#2f4a5a','#8a5a2b','#4a3b5a'];
---
<Base title="Writing"><h1>The library</h1>
{posts.length === 0 ? <p class="empty">No essays yet. Publish one in the CMS.</p> :
<ul class="books">{posts.map((p, i) => <li><a href={u(`/writing/${p.id}/`)} style={`--c:${cols[i % cols.length]}`}><b>{p.data.title}</b><span>{p.data.description}</span><small>{fmt(p.data.date)}</small></a></li>)}</ul>}
<style>.books{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(12rem,1fr));gap:1.5rem}
.books a{display:flex;flex-direction:column;gap:.5rem;min-height:15rem;padding:1.25rem 1.25rem 1.25rem 1.75rem;background:var(--c);border-left:12px solid #0004;text-decoration:none;box-shadow:5px 8px 14px #0008;transition:transform .2s}
.books a:hover,.books a:focus-visible{transform:translateY(-8px)}.books b{font:700 1.3rem var(--serif)}.books small{margin-top:auto}</style></Base>
